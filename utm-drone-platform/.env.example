# ---- Application ----
APP_NAME="SkyGrid UTM"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-character-string
API_V1_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL=sqlite:///./skygrid_utm.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://utm_user:utm_pass@localhost:5432/skygrid_utm

# ---- FAA LAANC Integration ----
# In production these come from an approved USS (UAS Service Supplier) integration.
LAANC_API_BASE_URL=https://api.laanc-sandbox.example.gov
LAANC_CLIENT_ID=your-laanc-client-id
LAANC_CLIENT_SECRET=your-laanc-client-secret
LAANC_USS_NAME="SkyGrid UTM Services"
LAANC_MOCK_MODE=true

# ---- Weather Service Integration ----
WEATHER_API_BASE_URL=https://api.weather.gov
WEATHER_API_KEY=your-weather-api-key
WEATHER_MOCK_MODE=true

# ---- ATC Coordination ----
ATC_FACILITY_FEED_URL=https://atc-coordination.example.gov/feed
ATC_MOCK_MODE=true

# ---- Deconfliction ----
MIN_HORIZONTAL_SEPARATION_M=50
MIN_VERTICAL_SEPARATION_M=15
LOOKAHEAD_WINDOW_SECONDS=300

# ---- Auth ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
